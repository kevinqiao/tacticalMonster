    "start": "vite",
    "build": "vite build",
    "build:verify": "vite build && npm run verify:dist-runtime-imports",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "preview": "vite preview",
    "test": "cross-env NODE_ENV=test jest",
    "test:vitest": "vitest",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:coverage": "vitest --coverage",
