# Convex deployment URL (cloud or self-hosted)
CONVEX_URL=https://beloved-mouse-699.convex.cloud

# Comma-separated API keys accepted by this MCP gateway.
# These must match keys created via mcp.keys:createApiKey (prefix mcp_sk_).
MCP_API_KEYS=mcp_sk_replace_me

# HTTP listen
PORT=8787
HOST=0.0.0.0

# Hostnames allowed when binding publicly (DNS rebinding protection)
ALLOWED_HOSTS=localhost,127.0.0.1
